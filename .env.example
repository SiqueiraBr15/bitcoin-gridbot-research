# Modelo de configuração. Copie para `PROJECT_ROOT/.env` SOMENTE quando necessário.
# `.env` é ignorado pelo Git e nunca deve ser versionado.
# Nenhum valor real deve ser escrito neste arquivo.
# Variáveis do environment do processo têm prioridade sobre o .env.
# Qualquer GRIDBOT_* desconhecida é erro (proteção contra erros de digitação).

# GRIDBOT_HOME define a raiz do projeto e NÃO pode ser definido aqui (ele localiza o .env).
# Defina no environment apenas se o pacote não estiver rodando a partir do checkout.

# Modos: backtest | paper | testnet | live
# Na Fase 0 apenas `backtest` é aceito para execução; `live` é bloqueado (LIVE_NOT_IMPLEMENTED).
GRIDBOT_MODE=backtest

# Diretórios: vazios = PROJECT_ROOT/data e PROJECT_ROOT/logs.
# Relativos são ancorados em PROJECT_ROOT (nunca no diretório atual); absolutos são usados
# como estão. Devem ficar FORA de OneDrive/SharePoint/rede.
GRIDBOT_DATA_DIR=
GRIDBOT_LOG_DIR=
GRIDBOT_DB_FILENAME=gridbot.sqlite3
GRIDBOT_LOG_LEVEL=INFO

# Credenciais Binance: NÃO usadas antes da Fase C.5 (testnet).
# Quando usadas: chave sem permissão de saque, restrita por IP, apenas Spot, e somente
# depois de endurecer a ACL do projeto (ADR-004).
GRIDBOT_BINANCE_API_KEY=
GRIDBOT_BINANCE_API_SECRET=
